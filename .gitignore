# IDE and Editor files
# These are generated by your code editor (VS Code, IntelliJ, etc.)
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS-specific files
# Windows, Mac, and Linux create these system files
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes
# Data stored by Docker containers (like database files)
postgres-data/
.docker/

# Environment files (contains secrets!)
# Never commit files with passwords, API keys, etc.
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
STUDY-GUIDE.md
MILESTONES.md
DEV-COMMANDS.md

# Python / Notebook local artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
.ipynb_checkpoints/
.venv/
.venv*/
venv/
env/

# Notebook pipeline outputs (regeneratable)
notebooks/data/
notebooks/models/
notebooks/ml-models/
ml-models/
notebooks/NOTEBOOK-BLOCK-GUIDE.local.md

# Test JSON files for curl commands
*.json
!**/package.json
!**/package-lock.json
